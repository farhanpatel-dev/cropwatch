# Copy this file to .env and change the values. Never commit .env.
POSTGRES_USER=cropwatch
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=cropwatch
# Port on your computer for PostGIS; use another (e.g. 55432) if a local PostgreSQL already has 5432
POSTGIS_HOST_PORT=5432
DATABASE_URL=postgresql+psycopg://cropwatch:change_me_locally@postgis:5432/cropwatch
INFERENCE_URL=http://inference:8001
GEO_URL=http://geo:8002
MODEL_PATH=/app/models/model.onnx
MODEL_INFO_PATH=/app/models/model_info.json
TILE_SIZE=256
TILE_OVERLAP=32
MAX_UPLOAD_MB=50
# Seconds the gateway waits for inference before 504 (120 on AWS, where Lambda has less CPU)
INFERENCE_TIMEOUT_S=60
# Browser origins allowed to call the gateway (comma separated); add your Vercel URL when hosted
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Inside Docker use http://mlflow:5000; for training on your own computer use http://localhost:5000
MLFLOW_TRACKING_URI=http://mlflow:5000
VITE_API_URL=http://localhost:8000
# AWS hosting only (ADR 0004; set by infra/aws/template.yaml). Leave empty locally.
UPLOAD_BUCKET=
SIGN_REQUESTS=
IMAGE_URL_PREFIXES=
