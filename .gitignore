# Secrets: real values live only in .env on your machine
.env

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# ML data, checkpoints and experiment tracking (too large for Git)
ml/data/
*.pt
*.onnx
mlruns/
mlartifacts/

# The served model is committed (decided 2026-11-08) so the inference image builds from a
# fresh clone. Only these three files; anything else in the folder stays out. These lines
# come after *.onnx above, so they win for model.onnx.
services/inference/models/*
!services/inference/models/.gitkeep
!services/inference/models/model.onnx
!services/inference/models/model_info.json
!services/inference/models/classes.yaml

# Frontend
node_modules/
frontend/dist/

# OS and editor clutter
.DS_Store
Thumbs.db
.idea/
